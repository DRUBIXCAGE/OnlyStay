# Environment variables for ONLYSTAY

# Database: SQLite default for local zero-dependency development
DATABASE_URL="file:./dev.db"

# For PostgreSQL deployment, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/onlystay?schema=public"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication
NEXTAUTH_SECRET="onlystay-jwt-secret-production-random-hash-min32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Payments (Connect / Checkout)
STRIPE_SECRET_KEY="sk_test_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Storage (Cloudinary / AWS S3 / Supabase)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
